# Copy this file to .env and fill in your own credentials. .env is
# gitignored — never commit real values.
#
# Get an API key/secret from addons.thunderbird.net's developer hub:
#   https://addons.thunderbird.net/en-US/developers/addon/api/key/
#
# These are ATN's own credentials, NOT the same as an addons.mozilla.org
# (AMO) API key — the two are separate accounts/services.

ATN_API_KEY=
ATN_API_SECRET=
