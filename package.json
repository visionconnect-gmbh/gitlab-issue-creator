{
  "name": "gitlab-issue-creator",
  "version": "8.0.0",
  "description": "Erstellt GitLab-Issues aus E-Mails.",
  "type": "module",
  "main": "background.js",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "scripts": {
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "build:dev": "pnpm install && node scripts/merge-locales.js",
    "build": "pnpm install && node scripts/build.js",
    "lint": "node scripts/build.js && addons-linter builds/*.xpi",
    "packSrc": "node scripts/pack-src.js",
    "publish": "node scripts/publish.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "keywords": [],
  "author": "kirchner@visionconnect.de",
  "license": "ISC",
  "devDependencies": {
    "addons-linter": "^10.13.0",
    "archiver": "^7.0.1",
    "dotenv": "^17.2.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsonwebtoken": "^9.0.2",
    "rimraf": "^6.0.1"
  }
}
